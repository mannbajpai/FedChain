# Environments
venv/
.venv/
env/
.env
.env.*
__pycache__/
*.pyc
*.pyo

# Data: keep the preparation script and the manifests, ignore the corpora.
# The non-IID manifest records the per-client label histogram the Dirichlet
# draw produced, which is needed to reproduce (and to report) that partition.
data/*
!data/.gitkeep
!data/prepare_data.py
!data/manifest.json
!data/dirichlet/
data/dirichlet/*
!data/dirichlet/manifest.json

# Model artefacts
*.pt
*.safetensors
*.bin
outputs/

# Results: keep the JSON reports, ignore the run logs
results/*.log

# Hardhat / local blockchain nodes
node_modules/
artifacts/
cache/
blockchain/artifacts/

# IPFS mock store
ipfs_mock/

# IDEs
.vscode/
.idea/
*.swp

.context/
